{
  "name": "cutver",
  "version": "1.2.0",
  "description": "Work out the next semver from conventional commits and write it into every manifest. Stops before publishing.",
  "author": "obillekyle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/cutver.git"
  },
  "homepage": "https://github.com/obillekyle/cutver#readme",
  "bugs": {
    "url": "https://github.com/obillekyle/cutver/issues"
  },
  "type": "module",
  "bin": {
    "cutver": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "release",
    "semver",
    "conventional-commits",
    "version",
    "monorepo",
    "cargo",
    "bun"
  ],
  "scripts": {
    "test": "bun test ./src --timeout 30000",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "release": "bun run src/cli.ts"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  }
}
